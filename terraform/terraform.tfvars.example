# Copy to terraform.tfvars (git-ignored) and adjust. Every value is optional
# because the defaults already describe this site.

# root_domain      = "notesbynisha.com"
# redirect_domains = ["nishacloud.com"]
# github_repo      = "Nisha318/notesbynisha-site"

# Set to false if this AWS account already has a GitHub OIDC provider.
# create_github_oidc_provider = true

# Temporary: forward old blog post addresses to the site that still hosts them.
# Remove this line once the posts have a permanent home, and always before
# adding that site's domain to redirect_domains.
# legacy_blog_origin = "https://www.nishacloud.com"

